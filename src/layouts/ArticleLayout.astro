---
import BaseLayout from "./BaseLayout.astro";
import SectionNavigator from "../components/SectionNavigator.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MermaidRenderer from "../components/MermaidRenderer.astro";
import type { SectionNavigation, TocHeading } from "../lib/navigation";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  meta?: string;
  active: "daily" | "research" | "archives" | "tech";
  headings?: TocHeading[];
  navigation?: SectionNavigation;
  hasMermaid?: boolean;
  contentSource?: string;
}

const { title, description, eyebrow, meta, active, headings = [], navigation, hasMermaid = false, contentSource = "" } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = tocHeadings.length >= 3;
const readableText = contentSource
  .replace(/---[\s\S]*?---/g, " ")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/[^\p{Script=Han}\p{Letter}\p{Number}\s]/gu, " ");
const hanCount = readableText.match(/\p{Script=Han}/gu)?.length ?? 0;
const latinWordCount = readableText.replace(/\p{Script=Han}/gu, " ").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = contentSource ? Math.max(1, Math.ceil(hanCount / 400 + latinWordCount / 220)) : undefined;
---

<BaseLayout {title} {description} {active}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <div class:list={["reading-shell", showToc && "has-toc"]}>
    <article class="article-page">
      <header class="article-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        {(meta || readingMinutes) && (
          <p class="article-meta">
            {meta && <span>{meta}</span>}
            {readingMinutes && <span>约 {readingMinutes} 分钟阅读</span>}
          </p>
        )}
        {navigation && <SectionNavigator {navigation} />}
      </header>
      {showToc && (
        <details class="mobile-toc">
          <summary>本文目录 <span>{tocHeadings.length} 节</span></summary>
          <TableOfContents headings={tocHeadings} />
        </details>
      )}
      <div class="article-body"><slot /></div>
      {hasMermaid && <MermaidRenderer />}
      {navigation && <SectionNavigator {navigation} position="bottom" />}
    </article>
    {showToc && (
      <aside class="article-toc">
        <TableOfContents headings={tocHeadings} />
      </aside>
    )}
  </div>
  {showToc && (
    <script>
      const articleHeadings = [...document.querySelectorAll<HTMLElement>(".article-body h2[id], .article-body h3[id]")];
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-slug]")];
      const setCurrent = (slug: string) => {
        tocLinks.forEach((link) => {
          if (link.dataset.tocSlug === slug) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };

      if (articleHeadings.length) {
        setCurrent(articleHeadings[0].id);
        const observer = new IntersectionObserver((entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
          if (visible[0]?.target.id) setCurrent(visible[0].target.id);
        }, { rootMargin: "-18% 0px -68% 0px", threshold: [0, 1] });
        articleHeadings.forEach((heading) => observer.observe(heading));
      }
    </script>
  )}
  <script>
    const enhanceMarkdown = () => {
      const body = document.querySelector<HTMLElement>(".article-body");
      if (!body || body.dataset.enhanced) return;
      body.dataset.enhanced = "true";

      body.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
        if (link.hostname === window.location.hostname) return;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.classList.add("external-link");
      });

      body.querySelectorAll<HTMLTableElement>("table").forEach((table) => {
        if (table.parentElement?.classList.contains("table-scroll")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "table-scroll";
        wrapper.tabIndex = 0;
        wrapper.setAttribute("role", "region");
        wrapper.setAttribute("aria-label", table.querySelector("th")?.textContent?.trim() || "数据表格");
        table.before(wrapper);
        wrapper.append(table);
      });

      body.querySelectorAll<HTMLPreElement>("pre").forEach((pre) => {
        if (pre.closest(".mermaid-figure") || pre.parentElement?.classList.contains("code-block")) return;
        const code = pre.querySelector("code");
        if (!code) return;
        const language = pre.dataset.language
          || [...code.classList].find((name) => name.startsWith("language-"))?.slice(9)
          || "text";
        const wrapper = document.createElement("div");
        wrapper.className = "code-block";
        const toolbar = document.createElement("div");
        toolbar.className = "code-toolbar";
        toolbar.innerHTML = `<span>${language}</span><button type="button" aria-label="复制代码">复制</button>`;
        pre.before(wrapper);
        wrapper.append(toolbar, pre);
        toolbar.querySelector("button")?.addEventListener("click", async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          try {
            await navigator.clipboard.writeText(code.textContent ?? "");
            button.textContent = "已复制";
            window.setTimeout(() => { button.textContent = "复制"; }, 1600);
          } catch { button.textContent = "复制失败"; }
        });
      });

      body.querySelectorAll<HTMLImageElement>("img[alt]").forEach((img) => {
        if (!img.alt || img.closest("figure") || img.parentElement?.childNodes.length !== 1) return;
        const paragraph = img.parentElement;
        const figure = document.createElement("figure");
        figure.className = "article-figure";
        const caption = document.createElement("figcaption");
        caption.textContent = img.alt;
        paragraph.before(figure);
        figure.append(img, caption);
        paragraph.remove();
      });

      body.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
        checkbox.closest("li")?.classList.add("task-item");
        checkbox.setAttribute("aria-label", checkbox.checked ? "已完成" : "未完成");
      });
    };

    enhanceMarkdown();

    const articleBody = document.querySelector<HTMLElement>(".article-body");
    const progressBar = document.querySelector<HTMLElement>(".reading-progress span");
    if (articleBody && progressBar) {
      let progressTicking = false;
      const updateProgress = () => {
        const articleTop = articleBody.getBoundingClientRect().top + window.scrollY;
        const readableDistance = Math.max(1, articleBody.offsetHeight - window.innerHeight * .72);
        const progress = Math.min(1, Math.max(0, (window.scrollY - articleTop + window.innerHeight * .18) / readableDistance));
        progressBar.style.transform = `scaleX(${progress})`;
        progressTicking = false;
      };
      const requestProgressUpdate = () => {
        if (!progressTicking) {
          window.requestAnimationFrame(updateProgress);
          progressTicking = true;
        }
      };
      window.addEventListener("scroll", requestProgressUpdate, { passive: true });
      window.addEventListener("resize", requestProgressUpdate);
      updateProgress();
    }

    document.querySelectorAll<HTMLElement>(".article-body blockquote").forEach((callout) => {
      const first = callout.querySelector("p:first-child");
      const match = first?.textContent?.match(/^\[!([a-z-]+)\]([+-])?\s*(.*)/i);
      if (!first || !match) return;
      callout.classList.add("obsidian-callout", `callout-${match[1].toLowerCase()}`);
      const title = match[3] || match[1].replace(/-/g, " ");
      first.textContent = title;
      first.classList.add("callout-title");
      first.setAttribute("data-callout-icon", "◆");
      if (match[2]) {
        callout.classList.add("is-foldable");
        const details = document.createElement("details");
        if (match[2] === "+") details.open = true;
        const summary = document.createElement("summary");
        summary.append(first);
        const content = document.createElement("div");
        content.className = "callout-content";
        while (callout.firstChild) content.append(callout.firstChild);
        details.append(summary, content);
        callout.append(details);
      }
    });
  </script>
</BaseLayout>
