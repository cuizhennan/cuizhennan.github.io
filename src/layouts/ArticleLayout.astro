---
import BaseLayout from "./BaseLayout.astro";
import SectionNavigator from "../components/SectionNavigator.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MermaidRenderer from "../components/MermaidRenderer.astro";
import type { SectionNavigation, TocHeading } from "../lib/navigation";

interface Props {
  title: string;
  displayTitle?: string;
  description: string;
  eyebrow: string;
  meta?: string;
  active: "daily" | "weekly" | "research" | "archives" | "tech";
  headings?: TocHeading[];
  navigation?: SectionNavigation;
  hasMermaid?: boolean;
  contentSource?: string;
}

const { title, displayTitle = title, description, eyebrow, meta, active, headings = [], navigation, hasMermaid = false, contentSource = "" } = Astro.props;
const compactDaily = active === "daily";
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const tocCount = compactDaily ? tocHeadings.filter(({ depth }) => depth === 2).length : tocHeadings.length;
const showToc = tocHeadings.length >= 3;
const readableText = contentSource
  .replace(/---[\s\S]*?---/g, " ")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/[^\p{Script=Han}\p{Letter}\p{Number}\s]/gu, " ");
const hanCount = readableText.match(/\p{Script=Han}/gu)?.length ?? 0;
const latinWordCount = readableText.replace(/\p{Script=Han}/gu, " ").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = contentSource ? Math.max(1, Math.ceil(hanCount / 400 + latinWordCount / 220)) : undefined;
---

<BaseLayout {title} {description} {active}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <div class:list={["reading-shell", showToc && "has-toc", compactDaily && "daily-reading"]}>
    <article class="article-page">
      <header class="article-header">
        {!compactDaily && <p class="eyebrow">{eyebrow}</p>}
        <h1>{displayTitle}</h1>
        {!compactDaily && <p class="article-summary">{description}</p>}
        {(meta || readingMinutes) && (
          <p class="article-meta">
            {compactDaily && <span class="article-series">{eyebrow}</span>}
            {meta && <span>{meta}</span>}
            {readingMinutes && <span>约 {readingMinutes} 分钟阅读</span>}
          </p>
        )}
        {navigation && (compactDaily ? <a class="article-archive" href="/github-daily/#daily">往期</a> : <SectionNavigator {navigation} />)}
      </header>
      {showToc && (
        <details class="mobile-toc">
          <summary>本文目录 <span>{tocCount || tocHeadings.length} 节</span></summary>
          <TableOfContents headings={tocHeadings} grouped={compactDaily} />
        </details>
      )}
      <div class="article-body"><slot /></div>
      {hasMermaid && <MermaidRenderer />}
      {navigation && <SectionNavigator {navigation} position="bottom" />}
    </article>
    {showToc && (
      <aside class="article-toc">
        <TableOfContents headings={tocHeadings} grouped={compactDaily} />
      </aside>
    )}
  </div>
  <script>
    const articleHeadings = [...document.querySelectorAll<HTMLElement>(".article-body h2[id], .article-body h3[id]")];
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-slug]")];
    const groupedTocs = [...document.querySelectorAll<HTMLElement>(".toc-grouped")];
    let currentSlug: string | undefined;
    const setCurrent = (slug?: string) => {
      if (slug === currentSlug) return;
      currentSlug = slug;
      tocLinks.forEach((link) => {
        if (link.dataset.tocSlug === slug) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
      groupedTocs.forEach((toc) => {
        toc.querySelector(".toc-active")?.classList.remove("toc-active");
        toc.querySelector('[aria-current="location"]')?.closest(".toc-section")?.classList.add("toc-active");
      });
    };

    if (groupedTocs.length) {
      groupedTocs.forEach((toc) => toc.classList.add("toc-enhanced"));
      let frame = 0;
      const updateCurrentSection = () => {
        const current = articleHeadings.findLast((heading) => !heading.closest(".article-sources:not([open])")
          && heading.getClientRects().length
          && heading.getBoundingClientRect().top <= window.innerHeight * .22);
        setCurrent(current?.id);
        frame = 0;
      };
      const scheduleUpdate = () => {
        if (!frame) frame = requestAnimationFrame(updateCurrentSection);
      };
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      scheduleUpdate();
      groupedTocs.forEach((toc) => toc.addEventListener("click", (event) => {
        if (!(event instanceof MouseEvent) || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("[data-toc-slug]");
        if (!link?.dataset.tocSlug) return;
        setCurrent(link.dataset.tocSlug);
        const panel = toc.closest(".mobile-toc");
        if (panel instanceof HTMLDetailsElement) panel.open = false;
        const target = document.getElementById(link.dataset.tocSlug);
        if (target) {
          const sources = target.closest(".article-sources");
          if (sources instanceof HTMLDetailsElement) sources.open = true;
          target.tabIndex = -1;
          target.focus({ preventScroll: true });
        }
      }));
    } else if (articleHeadings.length && tocLinks.length) {
      setCurrent(articleHeadings[0].id);
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top);
        if (visible[0]?.target.id) setCurrent(visible[0].target.id);
      }, { rootMargin: "-18% 0px -68% 0px", threshold: [0, 1] });
      articleHeadings.forEach((heading) => observer.observe(heading));
    }
  </script>
  <script>
    const enhanceMarkdown = () => {
      const body = document.querySelector<HTMLElement>(".article-body");
      if (!body || body.dataset.enhanced) return;
      body.dataset.enhanced = "true";

      if (body.closest(".daily-reading")) {
        const isSourceHeading = (node: Element) => {
          const title = node.textContent?.trim().replace(/^[^\p{L}]+/u, "") ?? "";
          return node.tagName === "H2"
            && /^(?:数据来源与口径|来源与口径|来源与采集口径|来源说明|来源|数据审计|采集审计|来源审计|Sources)$/i.test(title);
        };
        const children = [...body.children];
        const start = children.findIndex((node, index) => isSourceHeading(node)
          && children.slice(index + 1).every((sibling) => sibling.tagName !== "H2" || isSourceHeading(sibling)));
        if (start >= 0 && start < children.length - 1) {
          const details = document.createElement("details");
          details.className = "article-sources";
          const summary = document.createElement("summary");
          summary.textContent = "来源与采集口径";
          children[start].before(details);
          const footnotes = children.findIndex((node, index) => index > start && node.hasAttribute("data-footnotes"));
          details.append(summary, ...children.slice(start, footnotes < 0 ? undefined : footnotes));
        }
      }

      body.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
        if (link.hostname === window.location.hostname) return;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.classList.add("external-link");
      });

      body.querySelectorAll<HTMLTableElement>("table").forEach((table) => {
        if (table.parentElement?.classList.contains("table-scroll")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "table-scroll";
        wrapper.tabIndex = 0;
        wrapper.setAttribute("role", "region");
        wrapper.setAttribute("aria-label", table.querySelector("th")?.textContent?.trim() || "数据表格");
        table.before(wrapper);
        wrapper.append(table);
      });

      body.querySelectorAll<HTMLPreElement>("pre").forEach((pre) => {
        if (pre.closest(".mermaid-figure") || pre.parentElement?.classList.contains("code-block")) return;
        const code = pre.querySelector("code");
        if (!code) return;
        const language = pre.dataset.language
          || [...code.classList].find((name) => name.startsWith("language-"))?.slice(9)
          || "text";
        const wrapper = document.createElement("div");
        wrapper.className = "code-block";
        const toolbar = document.createElement("div");
        toolbar.className = "code-toolbar";
        toolbar.innerHTML = `<span>${language}</span><button type="button" aria-label="复制代码">复制</button>`;
        pre.before(wrapper);
        wrapper.append(toolbar, pre);
        toolbar.querySelector("button")?.addEventListener("click", async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          try {
            await navigator.clipboard.writeText(code.textContent ?? "");
            button.textContent = "已复制";
            window.setTimeout(() => { button.textContent = "复制"; }, 1600);
          } catch { button.textContent = "复制失败"; }
        });
      });

      body.querySelectorAll<HTMLImageElement>("img[alt]").forEach((img) => {
        if (!img.alt || img.closest("figure") || img.parentElement?.childNodes.length !== 1) return;
        const paragraph = img.parentElement;
        const figure = document.createElement("figure");
        figure.className = "article-figure";
        const caption = document.createElement("figcaption");
        caption.textContent = img.alt;
        paragraph.before(figure);
        figure.append(img, caption);
        paragraph.remove();
      });

      body.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
        checkbox.closest("li")?.classList.add("task-item");
        checkbox.setAttribute("aria-label", checkbox.checked ? "已完成" : "未完成");
      });
    };

    enhanceMarkdown();

    const articleBody = document.querySelector<HTMLElement>(".article-body");
    const progressBar = document.querySelector<HTMLElement>(".reading-progress span");
    if (articleBody && progressBar) {
      let progressTicking = false;
      const updateProgress = () => {
        const articleTop = articleBody.getBoundingClientRect().top + window.scrollY;
        const readableDistance = Math.max(1, articleBody.offsetHeight - window.innerHeight * .72);
        const progress = Math.min(1, Math.max(0, (window.scrollY - articleTop + window.innerHeight * .18) / readableDistance));
        progressBar.style.transform = `scaleX(${progress})`;
        progressTicking = false;
      };
      const requestProgressUpdate = () => {
        if (!progressTicking) {
          window.requestAnimationFrame(updateProgress);
          progressTicking = true;
        }
      };
      window.addEventListener("scroll", requestProgressUpdate, { passive: true });
      window.addEventListener("resize", requestProgressUpdate);
      updateProgress();
    }

    document.querySelectorAll<HTMLElement>(".article-body blockquote").forEach((callout) => {
      const first = callout.querySelector("p:first-child");
      const match = first?.innerHTML.match(/^\[!([a-z-]+)\]([+-])?[ \t]*([^\n]*)(?:\n([\s\S]*))?$/i);
      if (!first || !match) return;
      const type = match[1].toLowerCase();
      const icons: Record<string, string> = {
        abstract: "≡", summary: "≡", tldr: "≡", info: "i", todo: "✓",
        tip: "◆", success: "✓", question: "?", warning: "!", failure: "×",
        danger: "!", error: "×", bug: "◆", example: "◇", quote: "“", cite: "“",
      };
      callout.classList.add("obsidian-callout", `callout-${type}`);
      callout.dataset.callout = type;
      const title = match[3].trim() || type.replace(/-/g, " ");
      const inlineBody = match[4]?.trim();
      if (inlineBody) {
        const content = document.createElement("p");
        content.innerHTML = inlineBody;
        first.after(content);
      }
      first.textContent = title;
      first.classList.add("callout-title");
      first.setAttribute("data-callout-icon", icons[type] ?? "•");
      if (match[2]) {
        callout.classList.add("is-foldable");
        const details = document.createElement("details");
        if (match[2] === "+") details.open = true;
        const summary = document.createElement("summary");
        summary.append(first);
        const content = document.createElement("div");
        content.className = "callout-content";
        while (callout.firstChild) content.append(callout.firstChild);
        details.append(summary, content);
        callout.append(details);
      }
    });
  </script>
</BaseLayout>
