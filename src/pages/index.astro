---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { dailyDate, leadSummary, reportHeadline, titleFromBody } from "../lib/content";
import techManifest from "../../docs/obsidian/tech-knowledge/manifest.json";

const reports = (await getCollection("daily")).sort((a, b) => dailyDate(b.id).localeCompare(dailyDate(a.id)));
const weeklyReports = (await getCollection("weekly")).sort((a, b) => dailyDate(b.id).localeCompare(dailyDate(a.id)));
const latest = reports[0];
const latestDate = latest ? dailyDate(latest.id) : "";
const latestTitle = latest ? reportHeadline(titleFromBody(latest.body, "GitHub Trending 日报"), latestDate) : "";
const latestSummary = leadSummary(latest?.body);
const latestWeeklyDate = weeklyReports[0] ? dailyDate(weeklyReports[0].id) : undefined;
const latestTech = techManifest.entries[0];
---

<BaseLayout active="home">
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Personal Journal · Since 2017</p>
      <h1>把技术、远方与日常，写成可以慢慢翻阅的纸。</h1>
      <p class="lede">一份持续生长的个人刊物：追踪开源世界的当下，也为技术原理与远方的历史保存上下文。</p>
    </div>
    {latest && <article class="hero-edition">
      <p class="entry-meta">最新一期 · GitHub Trending 日报 <time datetime={latestDate}>{latestDate}</time></p>
      <h2><a href={`/github-daily/${latestDate}/`}>{latestTitle}</a></h2>
      {latestSummary && <p class="issue-summary">{latestSummary}</p>}
    </article>}
  </section>

  <section class="section-directory" aria-labelledby="directory-heading">
    <div class="section-heading">
      <h2 id="directory-heading">从哪里开始</h2>
    </div>
    <div class="directory-grid home-directory">
      <a href="/github-daily/">
        <strong>GitHub 观察</strong>
        <p>在一个目录中阅读日报与周报，从每日信号走向每周判断。</p>
      </a>
      <a href="/tech-knowledge/">
        <strong>技术知识</strong>
        <p>从系统原理到工程实践，整理值得反复查阅的知识。</p>
      </a>
      <a href="/japan-research/">
        <strong>日本研究</strong>
        <p>在出发前，先理解建筑、城市与历史留下的纹理。</p>
      </a>
    </div>
  </section>

  {(latestWeeklyDate || latestTech) && <section class="issue-list" aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">近来所写</h2>
    </div>
    {latestWeeklyDate && <article class="feature-entry">
      <p class="entry-meta">{latestWeeklyDate}</p>
      <div>
        <h3><a href={`/github-weekly/${latestWeeklyDate}/`}>GitHub Trending 周报</a></h3>
        <p>从一周日报中抽离短期噪声，辨认技术、产品与资本正在形成的结构性变化。</p>
        <a class="text-link" href="/github-daily/#weekly">翻阅最近周报 →</a>
      </div>
    </article>}
    {latestTech && <article class="feature-entry">
      <p class="entry-meta">{latestTech.date}</p>
      <div>
        <h3><a href={`/tech-knowledge/${latestTech.slug}/`}>{latestTech.title}</a></h3>
        <p>系统原理、工程实践与前沿论文的 Obsidian 长期知识库，支持 Mermaid 图表与章节阅读。</p>
        <a class="text-link" href="/tech-knowledge/">进入技术知识库 →</a>
      </div>
    </article>}
  </section>}
</BaseLayout>
