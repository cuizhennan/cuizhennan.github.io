---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeNote from "../components/ThemeNote.astro";
import { getCollection } from "astro:content";
import { dailyDate } from "../lib/content";
import { researchPages } from "../lib/content";
import techManifest from "../../docs/obsidian/tech-knowledge/manifest.json";

const reports = (await getCollection("daily")).sort((a, b) => dailyDate(b.id).localeCompare(dailyDate(a.id)));
const latestDate = reports[0] ? dailyDate(reports[0].id) : "2026-08-11";
const latestTech = techManifest.entries[0];
---

<BaseLayout active="home">
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Personal Journal · Since 2017</p>
      <h1>把技术、远方与日常，写成可以慢慢翻阅的纸。</h1>
      <p class="lede">一份持续生长的个人刊物：追踪开源世界的当下，也为技术原理与远方的历史保存上下文。</p>
    </div>
    <aside class="hero-edition" aria-label="本站内容概览">
      <p>Current edition</p>
      <strong>2026<span>／</span>08</strong>
      <dl>
        <div><dt>日报</dt><dd>{reports.length}</dd></div>
        <div><dt>技术笔记</dt><dd>{techManifest.entries.length}</dd></div>
        <div><dt>旅行研究</dt><dd>{researchPages.length}</dd></div>
      </dl>
    </aside>
  </section>

  <section class="section-directory" aria-labelledby="directory-heading">
    <div class="section-heading">
      <p class="eyebrow">Browse by section</p>
      <h2 id="directory-heading">从哪里开始</h2>
    </div>
    <div class="directory-grid">
      <a href="/github-daily/">
        <span>01 / DAILY</span>
        <strong>GitHub 日报</strong>
        <p>用技术、产品与投资三条线索，过滤每日开源信号。</p>
      </a>
      <a href="/tech-knowledge/">
        <span>02 / NOTES</span>
        <strong>技术知识</strong>
        <p>从系统原理到工程实践，整理值得反复查阅的知识。</p>
      </a>
      <a href="/japan-research/">
        <span>03 / JOURNEY</span>
        <strong>日本研究</strong>
        <p>在出发前，先理解建筑、城市与历史留下的纹理。</p>
      </a>
      <a href="/archives/">
        <span>04 / INDEX</span>
        <strong>全部归档</strong>
        <p>按时间浏览这份个人刊物一路积累的内容。</p>
      </a>
    </div>
  </section>

  <section class="issue-list" aria-labelledby="latest-heading">
    <div class="section-heading">
      <p class="eyebrow">Latest Issues</p>
      <h2 id="latest-heading">近来所写</h2>
    </div>
    <article class="feature-entry">
      <div class="entry-index">01</div>
      <div>
        <p class="entry-meta">{latestDate} · 技术 × 产品 × 投资</p>
        <h3><a href={`/github-daily/${latestDate}/`}>GitHub Trending 日报</a></h3>
        <p>从代码仓库、产品信号与投资叙事三条线索，观察开源生态正在发生的变化。</p>
        <a class="text-link" href="/github-daily/">翻阅最近日报 →</a>
      </div>
    </article>
    <article class="feature-entry">
      <div class="entry-index">02</div>
      <div>
        <p class="entry-meta">2026-05 · Travel Research</p>
        <h3><a href="/japan-research/">日本旅行研究素材</a></h3>
        <p>从博物馆、寺院、城市遗产与历史分层出发，为抵达日本之前准备一份厚实的上下文。</p>
        <a class="text-link" href="/japan-research/">进入研究目录 →</a>
      </div>
    </article>
    {latestTech && <article class="feature-entry">
      <div class="entry-index">03</div>
      <div>
        <p class="entry-meta">{latestTech.date} · Tech Knowledge</p>
        <h3><a href={`/tech-knowledge/${latestTech.slug}/`}>{latestTech.title}</a></h3>
        <p>系统原理、工程实践与前沿论文的 Obsidian 长期知识库，支持 Mermaid 图表与章节阅读。</p>
        <a class="text-link" href="/tech-knowledge/">进入技术知识库 →</a>
      </div>
    </article>}
  </section>

  <ThemeNote />
</BaseLayout>
