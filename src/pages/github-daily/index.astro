---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dailyDate, leadSummary, reportHeadline, titleFromBody } from "../../lib/content";

const series = await Promise.all(([
  { id: "daily", label: "日报" },
  { id: "weekly", label: "周报" },
] as const).map(async ({ id, label }) => {
  const entries = (await getCollection(id)).map((report) => {
    const date = dailyDate(report.id);
    const originalTitle = titleFromBody(report.body, `GitHub Trending ${label} · ${date}`);
    return {
      date,
      href: `/github-${id}/${date}/`,
      title: id === "daily" ? reportHeadline(originalTitle, date) : originalTitle,
      body: report.body,
    };
  }).sort((a, b) => b.date.localeCompare(a.date));
  return { id, label, entries, latest: entries[0], months: Object.groupBy(entries, ({ date }) => date.slice(0, 7)) };
}));
---

<BaseLayout title="GitHub Trending 观察" description="GitHub Trending 日报与周报，记录开源生态的每日进展与每周趋势。" active="daily">
  <header class="collection-intro">
    <h1>GitHub 观察</h1>
    <p>每天追踪开源进展，每周回看值得持续关注的趋势。</p>
  </header>

  <section class="latest-reports" aria-label="最新报告">
    {series.map(({ id, label, latest }) => {
      if (!latest) return null;
      const title = id === "weekly" ? latest.body?.match(/^###\s+(.+)$/m)?.[1] || "GitHub Trending 周报" : latest.title;
      const weeklyTheme = id === "weekly" ? latest.body?.match(/^>\s*\*\*本周总命题\*\*[：:]\s*(.+)$/m)?.[1] : undefined;
      const summary = leadSummary(weeklyTheme ?? latest.body, 85);
      return (
        <article>
          <p class="entry-meta">最新{label} <time datetime={latest.date}>{latest.date}</time></p>
          <h2><a href={latest.href}>{title}</a></h2>
          {summary && <p class="issue-summary">{summary}</p>}
        </article>
      );
    })}
  </section>

  <div class="report-archive">
    <nav class="report-jump" aria-label="报告类型">
      {series.map(({ id, label, entries }) => <a href={`#${id}`}>{label} <span>{entries.length} 期</span></a>)}
    </nav>

    {series.map(({ id, label, months }) => (
      <section class="report-section" id={id} aria-label={`${label}归档`}>
        {Object.entries(months).map(([month, reports]) => (
          <div class="report-month">
            <h2>{month.slice(0, 4)} 年 {Number(month.slice(5))} 月</h2>
            <ul>
              {reports?.map(({ date, href, title }) => (
                <li>
                  <time datetime={date}>{date.slice(5)}</time>
                  <a href={href}>{title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  const reportTypes = document.querySelectorAll<HTMLAnchorElement>(".report-jump a");
  const markCurrent = () => {
    const selected = location.hash === "#weekly" ? "#weekly" : "#daily";
    reportTypes.forEach((link) => {
      if (link.hash === selected) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };
  window.addEventListener("hashchange", markCurrent);
  markCurrent();
</script>
