{
  "name": "cuizhennan-github-pages",
  "version": "1.0.0",
  "private": true,
  "description": "墨萧的 Astro 静态博客与 Obsidian 内容站",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "node --test scripts/*.test.mjs",
    "build:daily": "node scripts/build-github-daily.mjs",
    "build:weekly": "node scripts/build-github-weekly.mjs",
    "sync:tech": "node scripts/sync-tech-knowledge.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && node scripts/check-site.mjs"
  },
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.9.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.14.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.9.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.0",
    "katex": "0.18.4",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.0",
    "mermaid": "11.16.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "5.9.3"
  }
}
